# ========================================================
# MOYO PLATFORM - CONFIGURATION D'ENVIRONNEMENT (.env.example)
# ========================================================

# Environnement (development / production / test)
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200
API_URL=http://localhost:3000

# Base de Données (PostgreSQL)
DATABASE_URL=postgresql://moyo_user:moyo_secret_password@localhost:5432/moyo_db?schema=public
POSTGRES_USER=moyo_user
POSTGRES_PASSWORD=moyo_secret_password
POSTGRES_DB=moyo_db
POSTGRES_PORT=5432

# Cache & Files de traitement (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sécurité & Tokens JWT (Remplacer impérativement en production)
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_min_32_chars
JWT_REFRESH_EXPIRATION=7d

# Stockage Objets (MinIO en local / S3 en production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=moyo-media
S3_FORCE_PATH_STYLE=true

# Streaming & Live Ingest
RTMP_INGEST_URL=rtmp://localhost:1935/live
HLS_OUTPUT_DIR=./storage/hls
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
