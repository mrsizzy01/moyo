# Moyo — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ─── Base de données PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql://moyo_user:moyo_password@localhost:5432/moyo_db

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=changeme-use-a-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=changeme-another-long-random-secret-at-least-64-chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── MinIO / S3 ───────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=moyo_minio
MINIO_SECRET_KEY=moyo_secret
MINIO_BUCKET=moyo-media
MINIO_USE_SSL=false

# ─── RTMP / HLS Live ─────────────────────────────────────────
RTMP_HOST=localhost
RTMP_PORT=1935
HLS_OUTPUT_DIR=/tmp/moyo-live/hls

# ─── Worker ──────────────────────────────────────────────────
WORKER_CONCURRENCY=2
FFMPEG_PATH=ffmpeg

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:3001

# ─── Email (optionnel — Nodemailer) ──────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@moyo.local
